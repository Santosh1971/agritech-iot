generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEALER
  CUSTOMER
}

enum Product {
  FG1
  FM1
  WM1_MINI
  WM1_PRO
  WPC
  TH
}

enum CommandStatus {
  SENT
  ACKED
  FAILED
  TIMEOUT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  phone         String?  @unique
  name          String
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())

  ownedDevices    Device[] @relation("DeviceOwner")
  dealerDevices   Device[] @relation("DeviceDealer")
  commandsSent    Command[]
  buildsUploaded  FirmwareBuild[]  @relation("BuildsUploaded")
  appBuildsUploaded MobileAppBuild[] @relation("AppBuildsUploaded")
  grantsIssued    FlasherGrant[]  @relation("GrantsIssued")
}

model OtpCode {
  id        String   @id @default(cuid())
  email     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([email, expiresAt])
}

model Device {
  id          String    @id @default(cuid())
  deviceId    String    @unique
  product     Product
  name        String
  ownerId     String?
  owner       User?     @relation("DeviceOwner", fields: [ownerId], references: [id])
  dealerId    String?
  dealer      User?     @relation("DeviceDealer", fields: [dealerId], references: [id])

  lastStatus  Json?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  readings    Reading[]
  commands    Command[]

  @@index([ownerId])
  @@index([dealerId])
}

model Reading {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  payload    Json
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

model Command {
  id         String        @id @default(cuid())
  cmdId      String        @unique @default(uuid())
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id])
  payloadId  String
  params     Json?
  status     CommandStatus @default(SENT)
  sentById   String
  sentBy     User          @relation(fields: [sentById], references: [id])
  sentAt     DateTime      @default(now())
  ackedAt    DateTime?
  ackPayload Json?

  @@index([deviceId, sentAt])
}

// NB Agri Flasher backend — see the project's memory note
// "kamta_flasher_app_initiative" and the published plan artifact for the
// full design. Firmware bins live on local disk (FIRMWARE_STORAGE_DIR),
// same "local on this VPS" pattern as everything else here — these three
// models are just the metadata/access-control layer on top.
model FirmwareBuild {
  id              String   @id @default(cuid())
  product         Product
  version         String
  variant         String   @default("esp32dev") // PlatformIO env name, e.g. esp32dev_ds1307
  storagePath     String   // app image — path relative to FIRMWARE_STORAGE_DIR
  bootloaderPath  String?  // present only for builds that support flashing a genuinely
  partitionsPath  String?  // blank chip (bootloader+partitions+app), not just an app-only update
  sha256          String
  sizeBytes       Int
  notes           String?
  uploadedById    String
  uploadedBy      User     @relation("BuildsUploaded", fields: [uploadedById], references: [id])
  createdAt       DateTime @default(now())

  flashEvents  FlashEvent[]

  @@index([product, version])
}

// The NB Agri Flasher Android app itself — separate from FirmwareBuild since
// one app build serves every product, so it doesn't fit under any single
// product's heading. buildType distinguishes CI's auto-built, debug-signed
// APKs (see .github/workflows/nb-agri-flasher-app.yml) from the manually
// built, release-signed ones meant to actually reach Kamta — CI never has
// the release keystore, by design (it lives only on a dev machine).
model MobileAppBuild {
  id           String   @id @default(cuid())
  versionName  String
  buildType    String   @default("debug") // "debug" | "release"
  storagePath  String   // path relative to FIRMWARE_STORAGE_DIR, same disk as firmware
  sha256       String
  sizeBytes    Int
  notes        String?
  uploadedById String
  uploadedBy   User     @relation("AppBuildsUploaded", fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// A grant, not a role — kept separate from Role/DEALER so access to the
// flasher can be switched off for one person without touching their main
// dashboard account. `active = false` is the entire revoke action, and it's
// checked live on every request from the app, never cached.
model FlasherGrant {
  id          String     @id @default(cuid())
  phone       String?
  email       String?
  label       String     // e.g. "Kamta — Bihar dealer"
  products    Product[]  // which products this grantee can see/flash
  active      Boolean    @default(true)
  grantedById String
  grantedBy   User       @relation("GrantsIssued", fields: [grantedById], references: [id])
  createdAt   DateTime   @default(now())
  revokedAt   DateTime?

  flashEvents FlashEvent[]

  @@index([phone])
  @@index([email])
}

model FlashEvent {
  id         String        @id @default(cuid())
  grantId    String
  grant      FlasherGrant  @relation(fields: [grantId], references: [id])
  buildId    String
  build      FirmwareBuild @relation(fields: [buildId], references: [id])
  deviceId   String?       // FG1's own reported device ID, if the app can read it
  result     String        // "downloaded" | "flash_ok" | "flash_failed"
  detail     String?
  occurredAt DateTime      @default(now())

  @@index([grantId, occurredAt])
}
