generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN     // Santosh, Avinash — sees everything
  DEALER    // e.g. Kamta — sees only devices assigned to them, full control
  CUSTOMER  // e.g. Girish, Vinay — sees only their own devices
}

enum Product {
  FG1      // Flow Guard
  FM1      // Flow Master
  WM1_MINI // Water Manager Mini (WiFi only)
  WM1_PRO  // Water Manager Pro (WiFi + LoRa)
  WPC      // Wireless Pump Controller
  TH       // Temperature/Humidity Monitor
  // PC (GSM Pump Controller) intentionally excluded — SMS-based, no MQTT/cloud presence
}

enum CommandStatus {
  SENT
  ACKED
  FAILED
  TIMEOUT
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique // primary login identifier — OTP-based auth, no password
  email         String?  @unique // optional, for notifications only
  name          String
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())

  ownedDevices    Device[] @relation("DeviceOwner")
  dealerDevices   Device[] @relation("DeviceDealer")
  commandsSent    Command[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
}

model Device {
  id          String   @id @default(cuid())
  deviceId    String   @unique // MAC-suffixed, e.g. "FG1_A1B2" — matches firmware's own ID scheme
  product     Product
  name        String   // friendly name set by owner/dealer, e.g. "North nursery pump"
  ownerId     String?  // null until Admin assigns the device to a customer
  owner       User?    @relation("DeviceOwner", fields: [ownerId], references: [id])
  dealerId    String?
  dealer      User?    @relation("DeviceDealer", fields: [dealerId], references: [id])

  lastStatus  Json?    // last retained payload from agrisense/<product>/<deviceId>/status
  lastSeenAt  DateTime?
  createdAt   DateTime @default(now())

  readings    Reading[]
  commands    Command[]

  @@index([ownerId])
  @@index([dealerId])
}

// Generic telemetry store — payload shape is product-specific (flow rate, temp/humidity,
// valve/relay states, etc.), kept as JSON rather than one table per product so new products
// don't need a migration to start logging data.
model Reading {
  id        String   @id @default(cuid())
  deviceId  String
  device    Device   @relation(fields: [deviceId], references: [id])
  payload   Json
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

model Command {
  id         String        @id @default(cuid())
  cmdId      String        @unique @default(uuid()) // correlates with cmd/ack topic payload
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id])
  payloadId  String        // e.g. "SetParameter", "SystemReset", "SetTime"
  params     Json?
  status     CommandStatus @default(SENT)
  sentById   String
  sentBy     User          @relation(fields: [sentById], references: [id])
  sentAt     DateTime      @default(now())
  ackedAt    DateTime?
  ackPayload Json?

  @@index([deviceId, sentAt])
}
