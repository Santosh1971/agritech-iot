generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  DEALER
  CUSTOMER
}

enum Product {
  FG1
  FM1
  WM1_MINI
  WM1_PRO
  WPC
  TH
}

enum CommandStatus {
  SENT
  ACKED
  FAILED
  TIMEOUT
}

model User {
  id            String   @id @default(cuid())
  phone         String   @unique
  email         String?  @unique
  name          String
  role          Role     @default(CUSTOMER)
  createdAt     DateTime @default(now())

  ownedDevices    Device[] @relation("DeviceOwner")
  dealerDevices   Device[] @relation("DeviceDealer")
  commandsSent    Command[]
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  code      String
  expiresAt DateTime
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, expiresAt])
}

model Device {
  id          String    @id @default(cuid())
  deviceId    String    @unique
  product     Product
  name        String
  ownerId     String?
  owner       User?     @relation("DeviceOwner", fields: [ownerId], references: [id])
  dealerId    String?
  dealer      User?     @relation("DeviceDealer", fields: [dealerId], references: [id])

  lastStatus  Json?
  lastSeenAt  DateTime?
  createdAt   DateTime  @default(now())

  readings    Reading[]
  commands    Command[]

  @@index([ownerId])
  @@index([dealerId])
}

model Reading {
  id         String   @id @default(cuid())
  deviceId   String
  device     Device   @relation(fields: [deviceId], references: [id])
  payload    Json
  recordedAt DateTime @default(now())

  @@index([deviceId, recordedAt])
}

model Command {
  id         String        @id @default(cuid())
  cmdId      String        @unique @default(uuid())
  deviceId   String
  device     Device        @relation(fields: [deviceId], references: [id])
  payloadId  String
  params     Json?
  status     CommandStatus @default(SENT)
  sentById   String
  sentBy     User          @relation(fields: [sentById], references: [id])
  sentAt     DateTime      @default(now())
  ackedAt    DateTime?
  ackPayload Json?

  @@index([deviceId, sentAt])
}
