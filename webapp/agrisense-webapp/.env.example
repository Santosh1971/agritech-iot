# Postgres (local on the VPS, same pattern as AlgoMomentum Bridge)
DATABASE_URL="postgresql://agrisense:CHANGE_ME@localhost:5432/agrisense"

# JWT signing secret for OTP session cookies
JWT_SECRET="CHANGE_ME_long_random_string"

# Email OTP via Resend (free tier). Leave RESEND_API_KEY unset to fall back to
# console-logging the code instead of sending a real email (local dev only).
RESEND_API_KEY=""
EMAIL_FROM="NB Agri Flasher <onboarding@resend.dev>"

# MQTT broker (Mosquitto on this same VPS)
MQTT_BROKER_URL="mqtt://localhost:1883"
MQTT_ADMIN_USERNAME="agrisense-backend"
MQTT_ADMIN_PASSWORD="CHANGE_ME"
