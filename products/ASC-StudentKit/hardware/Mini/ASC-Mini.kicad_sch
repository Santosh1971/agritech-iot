	(text "12 V IN (9-24 V): reverse-polarity diode D1, TVS D2, then the TPS54202 buck set to 5.3 V; D3 drops it to ~5.0 V on the +5V rail."
		(exclude_from_sim no)
		(at 20.32 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2ffe4d02-4b0a-4ba4-ab49-8db5bb524d59")
	)
	(text "USB-C: flashing and the serial console (native USB on GPIO19/20), and 5 V for desk use. F1 + D4 feed the +5V rail; CC pull-downs ask for 5 V."
		(exclude_from_sim no)
		(at 20.32 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "5a0391fe-6717-49e1-ae30-bb6eea97ae5f")
	)
	(text "+5V -> 3.3 V: AP7361C (1 A LDO) for the ESP32-S3 (WiFi peaks ~350 mA), the RTC and the 3.3 V sensor supply."
		(exclude_from_sim no)
		(at 170.18 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "12f01233-f61b-4d61-9a28-3e6b00932caf")
	)
	(text "MCU: ESP32-S3-MINI-1-N8 (no PSRAM, so GPIO35-37 stay free). Pins per hardware/pinmap.json, board 'mini'."
		(exclude_from_sim no)
		(at 63.5 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "bcd8dda0-4d98-4612-b845-9e0858ca4b2e")
	)
	(text "Internal I2C (GPIO12/13): DS3231MZ RTC at 0x68 + CR2032 (back side). INT/SQW on GPIO16 can wake the board."
		(exclude_from_sim no)
		(at 210.82 134.62 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ae42f327-4750-4cb6-afbe-892e81fe9b5a")
	)
	(text "Sensor ports S1-S4 (JST-XH 4-pin: 1 GND, 2 3V3, 3 5V, 4 SIG). SIG: 470R series + BAT54S clamps, so a 5 V digital signal is safe."
		(exclude_from_sim no)
		(at 20.32 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "abeda1ff-dde0-422e-84ef-8c69dbc31952")
	)
	(text "Both port supplies are fused (F2, F3). Pull-ups a block needs (DS18B20 4.7k, DHT22 10k) live on the block or its adapter."
		(exclude_from_sim no)
		(at 20.32 224.79 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "241cbfd0-8614-4a55-bad8-5143121c3534")
	)
	(text "I2C-1 student port, Grove pinout (1 SCL, 2 SDA, 3 3V3, 4 GND), on its own bus (GPIO14/15)."
		(exclude_from_sim no)
		(at 210.82 220.98 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "450a1ff9-dfd1-4bd4-a0da-31bc3feaef2e")
	)
	(text "Relays OUT1/OUT2 (GPIO35/36): Hongfa HF46F-005 (1 Form A, 5 A, 40 mA coil), low-side AO3400A, flyback diode, coil LED (shows through the lid)."
		(exclude_from_sim no)
		(at 297.18 81.28 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "03142e8b-362d-4e43-8d01-7016f7b264b8")
	)
	(text "Terminals: 1 COM, 2 NO. Silkscreen: LOW VOLTAGE ONLY (switch a contactor coil, not a pump)."
		(exclude_from_sim no)
		(at 297.18 85.09 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
