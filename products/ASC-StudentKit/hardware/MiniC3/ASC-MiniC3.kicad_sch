	)
	(text "MCU: ESP32-C3 Super Mini, plugged into 2 x 8-pin sockets."
		(exclude_from_sim no)
		(at 25.4 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "eb915518-9b7b-4673-a7d3-8978a3ac1dd3")
	)
	(text "Its USB-C powers the board (5 V / 1 A charger in the field): the 5V pin"
		(exclude_from_sim no)
		(at 25.4 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4aa3df39-9723-4fe2-b02e-cc848cf63ee1")
	)
	(text "(USB VBUS) feeds the pump, the relay coil, the flow sensor and the RTC;"
		(exclude_from_sim no)
		(at 25.4 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "c6c6346a-268a-40de-98ba-4934d3a4c1b6")
	)
	(text "the 3V3 pin (on-module LDO) feeds the sensors and pull-ups."
		(exclude_from_sim no)
		(at 25.4 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "56921beb-970c-4efa-97b4-51682b8a5d1e")
	)
	(text "Left free: GPIO2 and GPIO8/9 (strapping; GPIO8 = module LED, GPIO9 = BOOT), GPIO21."
		(exclude_from_sim no)
		(at 25.4 55.88 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "481ab4d0-6520-413a-8329-7e8fccfc2ece")
	)
	(text "RTC: DS1307 at 0x68, on 5 V (it needs 4.5-5.5 V)."
		(exclude_from_sim no)
		(at 154.94 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a0a52d83-18de-464e-ab6b-de6afbe87435")
	)
	(text "I2C pull-ups go to 3V3: the DS1307 reads 3.3 V as high (VIH 2.2 V)."
		(exclude_from_sim no)
		(at 154.94 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7ca949cf-7670-4e25-8f34-23a046387b3c")
	)
	(text "Backup: CR2032 with solder tabs, standing vertical (no holder)."
		(exclude_from_sim no)
		(at 154.94 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "3db80fa6-3922-42ac-9d9e-7bb6c49aad58")
	)
	(text "Crystal 32.768 kHz, 12.5 pF load."
		(exclude_from_sim no)
		(at 154.94 52.07 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "ba2016f6-d7c2-4aaa-98a4-98ef25ffc988")
	)
	(text "I2C terminal: 3V3 GND SCL SDA, the pin order of the ASC-AHT20"
		(exclude_from_sim no)
		(at 292.1 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7a952398-4476-4d40-90e0-69dfeb9a8eb7")
	)
	(text "board and of most AHT20 / BMP280 / BH1750 modules (VIN GND SCL SDA)."
		(exclude_from_sim no)
		(at 292.1 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "8311857a-f334-4f53-b606-99eb7c3de941")
	)
	(text "AUX: D = GPIO4 with a 10k pull-up (DHT11/DHT22 or a DS18B20 probe),"
		(exclude_from_sim no)
		(at 25.4 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "595266e6-28f1-40df-b1be-03e80119f30c")
	)
	(text "A0/A1 = GPIO0/1 on ADC1 (soil-moisture probe, LDR, pot, switch)."
		(exclude_from_sim no)
		(at 25.4 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "4daa9820-4301-4122-910b-2243f6db0f1a")
	)
	(text "Flow: YF-S401 on 5 V (needs 5-24 V), 5880 pulses per litre."
		(exclude_from_sim no)
		(at 116.84 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "44e10ba8-3cd1-4b5d-a32c-78c9e208101f")
	)
	(text "Its output can swing to 5 V, so Schottky D2 only pulls GPIO5 low"
		(exclude_from_sim no)
		(at 116.84 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "19709563-99fb-4601-add6-e2406e72fa5e")
	)
	(text "and R6 pulls it up to 3V3. The FLOW LED sinks into the sensor"
		(exclude_from_sim no)
		(at 116.84 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9a2b75d7-d8f5-4e53-9b4f-a07584105408")
	)
	(text "output, so it blinks with every pulse (no GPIO needed)."
		(exclude_from_sim no)
		(at 116.84 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a44040f3-301b-4001-8eaa-9ee75b38fdab")
	)
	(text "Pump: 5 V DC submersible (about 0.2-0.3 A). Low-side AO3400A;"
		(exclude_from_sim no)
		(at 228.6 157.48 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "7820ecf4-8a29-41ae-a1c8-3ea171e8b571")
	)
	(text "R2 holds it off through reset; D1 is the flyback diode."
		(exclude_from_sim no)
		(at 228.6 161.29 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "9d30e0a3-fdc1-4c85-bebf-834f57f2fb20")
	)
	(text "PUMP LED sits across the switch side: lit while the pump is driven."
		(exclude_from_sim no)
		(at 228.6 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "88647ba8-76b5-4365-8ce2-35a180d1dc82")
	)
	(text "C1 rides out the start-up surge of the pump and the relay on USB 5 V."
		(exclude_from_sim no)
		(at 228.6 168.91 0)
		(effects
			(font
				(size 1.27 1.27)
			)
