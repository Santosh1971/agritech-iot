		(uuid "cc8682f8-1332-4dd3-a2a6-a788eadc5139")
	)
	(text "R11 holds it off through reset. RELAY LED across the coil. Contacts on a 5.08 mm"
		(exclude_from_sim no)
		(at 309.88 165.1 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1fe78906-8878-4f71-9ac5-cd6995207cb6")
	)
	(text "terminal; 230 V copper keeps >= 5 mm from everything else (.kicad_dru rule)."
