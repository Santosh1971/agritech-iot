				(bold yes)
			)
		)
		(uuid "6bd68b02-6848-4264-86bd-5b4d0521f76c")
	)
	(text "On Board LED as WiFi and \nPower LED"
		(exclude_from_sim no)
		(at 223.52 168.402 0)
