	)
	(text "Programmer cum Debugger\nhttps://evelta.com/7semi-st-link-v2-v2-1-usb-c-debugger-programmer-for-stm32-mcus/\nFrom the photo, the 7Semi ST‑Link V2 has this pin order (top to bottom on the right header):\n\nSWO\n\nRST\n\nSWDIO\n\nGND\n\nSWCLK\n\n3V3\n\nOn your STM32G030 board, make a 6‑pin (or 5‑pin) header in the same order, and wire:\n\nSWO → optional (PB3, can be left NC for now)\n\nRST → NRST\n\nSWDIO → PA13\n\nGND → GND\n\nSWCLK → PA14\n\n3V3 → 3.3 V rail"
		(exclude_from_sim no)
		(at -196.723 330.835 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "41f4a4ef-e4b1-45d5-b649-a7cfc3f119b5")
	)
	(text "RL1"
		(exclude_from_sim no)
		(at 260.985 189.865 0)
		(effects
			(font
