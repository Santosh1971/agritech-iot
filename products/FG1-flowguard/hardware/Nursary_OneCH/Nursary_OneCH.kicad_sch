	(text "Close to connector"
		(exclude_from_sim no)
		(at 205.74 113.792 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "1638705e-d972-4606-97db-74720adcbf57")
	)
	(text "Programmer cum Debugger\nhttps://evelta.com/7semi-st-link-v2-v2-1-usb-c-debugger-programmer-for-stm32-mcus/\nFrom the photo, the 7Semi ST‑Link V2 has this pin order (top to bottom on the right header):\n\nSWO\n\nRST\n\nSWDIO\n\nGND\n\nSWCLK\n\n3V3\n\nOn your STM32G030 board, make a 6‑pin (or 5‑pin) header in the same order, and wire:\n\nSWO → optional (PB3, can be left NC for now)\n\nRST → NRST\n\nSWDIO → PA13\n\nGND → GND\n\nSWCLK → PA14\n\n3V3 → 3.3 V rail"
		(exclude_from_sim no)
		(at -196.723 330.835 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
			)
		)
		(uuid "41f4a4ef-e4b1-45d5-b649-a7cfc3f119b5")
	)
	(text "IO lines needed\n\nSensor Node - 12\n\n1.Flow Sensor - 4 interrupt\n2.LED Flow - 4\n3. RS485	- 3 \n4. RS485 -Tx LED - 1\n\n\n\n\n"
		(exclude_from_sim no)
		(at -110.363 11.811 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 1.016)
				(bold yes)
			)
			(justify left)
		)
		(uuid "58ca87a1-ef28-4285-987c-c0af785a5742")
	)
	(text "RTC (any one to use)"
		(exclude_from_sim no)
		(at 322.326 164.211 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "5e1005e6-d300-493a-b88b-5f5718c65fae")
	)
	(text "On Board LED \nas WiFi and \nPower LED"
		(exclude_from_sim no)
		(at 386.334 123.444 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "70df72c5-bb9f-4c50-bd6c-8e504988e26e")
	)
	(text "Node Pin Assignment (12 Functional + 2 Debug IOs)\nFunction	IO Count	STM32 Pin Port/Periph		Notes\nFlow Sensor 1	1	PA4 (EXTI4)	GPIOA/EXTI	Rising edge interrupt\nFlow Sensor 2	1	PA5 (EXTI5)	GPIOA/EXTI	Rising edge interrupt\nFlow Sensor 3	1	PA6 (EXTI6)	GPIOA/EXTI	Rising edge interrupt\nFlow Sensor 4	1	PA7 (EXTI7)	GPIOA/EXTI	Rising edge interrupt\nLED Flow 1		1	PB6			GPIOB		Push-pull output\nLED Flow 2		1	PB7			GPIOB		Push-pull output\nLED Flow 3		1	PB8			GPIOB		Push-pull output\nLED Flow 4		1	PB9			GPIOB		Push-pull output\n\n\nRS485 TX		1	PA9		USART1_TX	19200 baud\nRS485 RX		1	PA10	USART1_RX	-\nRS485 DE/RE		1	PA8		GPIOA		High = TX mode\nRS485 TX LED	1	PB11	GPIOB		Blinks on transmit\n\n\nDebug TX		1	PA2	USART2_TX		Independent printf @115200\nDebug RX		1	PA3	USART2_RX		Independent serial input\n"
		(exclude_from_sim no)
		(at -251.968 132.842 0)
		(effects
			(font
				(size 3.81 3.81)
				(thickness 0.762)
				(bold yes)
			)
			(justify left)
		)
		(uuid "76fd52b0-e73f-4866-9186-d78871a1a008")
	)
	(text "FTDI USB-to-TTL adapter connected to the 6-pin header \non the board's edge. The pinout alignment is typically: \nDTR, TXO, RXI, VCC, CTS, and GND. Key connections are \nDTR-to-DTR, TX-to-RXI, RX-to-TXO, VCC-to-VCC, and GND-to-GND"
		(exclude_from_sim no)
		(at 139.319 326.263 0)
		(effects
			(font
				(size 3.81 3.81)
			)
		)
		(uuid "79e692d3-21ba-41f8-a1bd-884da445bc2c")
	)
