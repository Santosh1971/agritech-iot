		(uuid "8ddb9810-839a-4d73-bbb1-ad44630ae4ab")
	)
	(text "LoRa: ISC-SX1262-B in Ra-01 footprint - same module and pin map as WPC (BUSY = pad 10). SMA -> pigtail -> antenna on a 1.5 m pole above the canopy."
		(exclude_from_sim no)
		(at 210.82 33.02 0)
		(effects
			(font
