	(text "Power: LiFePO4 14500 straight onto the 3V3 rail (3.0-3.4 V plateau, no regulator, ~0 uA quiescent). Q1 = reverse-polarity protection."
		(exclude_from_sim no)
		(at 25.4 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
