				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "e2e01418-007a-4e62-8aad-e114570364be")
	)
	(text "Pads sit on F.Cu with NO mask opening; traces run on In2.Cu between In1 (hatched GND) and B.Cu (solid GND). Coat the whole strip."
