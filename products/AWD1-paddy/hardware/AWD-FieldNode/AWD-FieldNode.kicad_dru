(version 1)

# v0.3, 2 layers. 50 ohm antenna feed: grounded coplanar waveguide on 1.6 mm FR4, 1.0 mm track on F.Cu
# with the F.Cu GND pour 0.2 mm away and solid GND on B.Cu. The feed is only ~11 mm (about lambda/16 at
# 866 MHz in FR4), so a small impedance error costs very little.
(rule "RF feed pour gap"
  (constraint clearance (min 0.2mm))
  (condition "A.NetClass == 'RF' && B.Type == 'Zone'"))

# Strip: each sense lane sits between two GND guard traces, 0.15 mm apart (JLC 2-layer minimum is 0.127 mm).
(rule "Strip guards"
  (constraint clearance (min 0.15mm))
  (condition "A.NetClass == 'Sense' && B.NetName == 'GND'"))

