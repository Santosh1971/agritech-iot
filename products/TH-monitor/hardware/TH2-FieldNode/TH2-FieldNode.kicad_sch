				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "2557c44e-de06-435a-a8f3-29977afee3d9")
	)
	(text "VBAT sense: R8/R9 2.2M/2.2M, always on (0.8 uA)."
