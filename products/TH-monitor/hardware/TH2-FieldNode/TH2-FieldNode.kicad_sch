	(text "USB-C / magnetic pogo input -> F1 polyfuse -> CN3058E LiFePO4 charger. CC1/CC2 5.1k pull-downs so any USB-C charger gives 5 V."
		(exclude_from_sim no)
		(at 25.4 33.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "14b60320-3c30-4909-a287-14a7ae1d5d88")
	)
	(text "U4 USBLC6 = ESD on D-/D+/VBUS. J2 is the same signals for an enclosure-wall magnetic connector (fit J1 or J2)."
		(exclude_from_sim no)
		(at 25.4 36.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "a740b65b-f1d8-4078-b6c0-7910ffb6fdd7")
	)
	(text "Charger: ICH = 1218 V / R3 = 0.31 A (0.5C). R4 0R: TEMP low = NTC off."
		(exclude_from_sim no)
		(at 116.84 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "34db8446-41e1-437c-b82c-06cde31675c3")
	)
	(text "RED = charging, GREEN = full (LEDs run off VBUS only)."
		(exclude_from_sim no)
		(at 116.84 44.45 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "884cc084-02d2-4f38-8dc4-754073afb5c8")
	)
	(text "Battery: LiFePO4 14500 (2.9-3.6 V). Q1 = reverse protection."
		(exclude_from_sim no)
		(at 228.6 40.64 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "58efa581-915e-4c36-ab9c-a58fd944e18f")
	)
	(text "U3 RT9080-33 (2 uA Iq) keeps 3.6 V charge off the C3."
